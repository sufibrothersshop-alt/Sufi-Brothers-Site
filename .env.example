# Supabase project settings -> API
# Safe to expose to the browser (used only to call the place_order RPC):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_, never commit the real value.
# Used only by the admin panel (Server Components / Route Handlers) — bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel login (simple username/password, no Supabase Auth involved).
# One pair per branch — whichever pair you log in with decides which
# branch's admin panel you land in. Pick your own usernames/passwords.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_KHANA_USERNAME=
ADMIN_KHANA_PASSWORD=
# Random secret used to sign the admin session cookie (shared by every
# branch) — generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
